<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Heredamos del parent de Spring Boot solo para tener las versiones de las dependencias alineadas. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.flety</groupId>
    <artifactId>flety-commons</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>flety-commons</name>
    <description>Librería común de Flety: excepciones, manejo de errores, contrato interno y clientes externos</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        A propósito NO se declara spring-boot-maven-plugin: su goal "repackage" convertiría el JAR
        en un ejecutable (con las clases en BOOT-INF/) y los servicios no podrían usarlo como dependencia.
    -->
</project>
