      "credentials": [
        { "type": "password", "value": "dador1", "temporary": false }
      ],
      "realmRoles": ["DADOR"]
    },
    {
      "username": "operador1",
      "enabled": true,
      "email": "operador1@flety.test",
      "emailVerified": true,
      "firstName": "Operador",
      "lastName": "Uno",
      "credentials": [
        { "type": "password", "value": "operador1", "temporary": false }
      ],
