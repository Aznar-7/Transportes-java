# Copiar a .env (que está en .gitignore) y cambiar los valores si hace falta.
# docker compose lee .env solo, desde la carpeta donde se corre.

# Superusuario de Postgres (solo para administrar; los servicios no lo usan)
POSTGRES_PASSWORD=postgres

# Un usuario por servicio. Tienen que coincidir con lo que use cada servicio
# (DB_PASSWORD en cargas, application-local.yml en transporte).
TRANSPORTE_DB_PASSWORD=transporte
CARGAS_DB_PASSWORD=cargas

# Administrador de la consola de Keycloak (http://localhost:8081/admin)
KEYCLOAK_ADMIN_PASSWORD=admin
